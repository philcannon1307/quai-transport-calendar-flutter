# Every setting of the token-exchange service. Copy the NAMES into Railway -> Variables.
# NEVER commit a real .env file. Values below are placeholders.

# --- REQUIRED ---------------------------------------------------------------

# One JSON object, on ONE line. Key = the name shown in the app's login list (or a truck account name).
#   "<name>": "<code>"                         the code the person types is also the truck's password
#   "<name>": {"code": "<code>", "password": "***"}   when they differ
# Needed entries:
#   - every person in the login list (see README for the full list)
#   - RIDEAU GOOSENECK and OPEN GOOSENECK (InterQL and SADM - Logistique use them)
#   - SADM - Logistique (its own login code; its truck account is "SADM - David")
CARRIER_CREDENTIALS_JSON={"InterQL":{"code":"CHANGE-ME"},"RIDEAU GOOSENECK":{"password":"***"},"OPEN GOOSENECK":{"password":"***"},"SADM - David":"CHANGE-ME","SADM - Logistique":{"code":"CHANGE-ME"}}

# Secret that signs the session tokens. At least 32 characters.
# Generate a random value (e.g. 40+ random characters from a password manager) and put THE SAME value
# in the Supabase edge-function secret SESSION_JWT_SECRET (Lovable: Cloud -> Secrets). Not Supabase's own JWT secret.
SESSION_JWT_SECRET=CHANGE…long

# Exact web addresses allowed to call this service, comma separated. No "*", no trailing path.
ALLOWED_ORIGINS=https://cb-eizwphr4mvsyclijai8x--preview-l3lvpbdx.web.app

# --- SUPERUSER (/admin) -- optional; without it the /admin login is disabled -------
SUPERUSER_USERNAME=CHANGE-ME
# Preferred: a hash made with "npm run hash-password" (looks like scrypt$...$...)
SUPERUSER_PASSWORD_HASH=
# Alternative if you cannot run the hash command (less safe): the plain password
SUPERUSER_PASSWORD=

*** --- PICK-UPS PROXY (SADM - Logistique pick-ups tab) --------------------------
# The after-sales middleware key. Server-side only: never in the app, never in a response or a log.
# Without it the proxy answers 503 and the app says pick-ups are unavailable.
MIDDLEWARE_API_KEY=***
# MIDDLEWARE_URL=https://quai-backend-methods-production.up.railway.app
# MIDDLEWARE_TIMEOUT_MS=15000

# --- OPTIONAL (defaults shown) ------------------------------------------------
# Railway sets PORT for you. Leave it alone.
# PORT=3000
JOB_SERVICE_URL=https://quai-contractor-calendar-production.up.railway.app
# How long a session token lives, in seconds (60 to 86400). Default 12 hours.
SESSION_TTL_SECONDS=43200
# Seconds-to-wait for the job service (milliseconds, 1000 to 60000).
JOB_TIMEOUT_MS=15000
# How many proxies sit in front of this service (Railway = 1). Used to find the real client IP.
TRUST_PROXY_HOPS=1


# --- DATA API (replaces the Lovable Cloud / Supabase project) ---------------------------
# Postgres connection string. On Railway: add a PostgreSQL service and reference its DATABASE_URL
# (use the private ".railway.internal" address). Without it the data API answers 503.
DATABASE_URL=
# This server's own public https address (used in picture links), e.g. https://xxxx.up.railway.app
PUBLIC_BASE_URL=
# Address of the web app (used in the "unsubscribe" link of emails), e.g. https://quai.example.com
PUBLIC_SITE_URL=
# Email sending: resend | sendgrid | log (log = nothing is sent, only written to the log)
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=Groupe QL Transport <noreply@notify.groupeql.com>
EMAIL_REPLY_TO=
